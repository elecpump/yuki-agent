{
  "manifest_version": 3,
  "name": "Yuki DOM Text Bridge",
  "version": "0.1.0",
  "description": "Sends visible page text to the local Yuki Native Messaging host.",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
